# Postgres connection string for the poller.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Comma-separated board:interval pairs. Optional — defaults to
# "g:20s,sci:20s,diy:20s,3:20s".
# POLLER_BOARDS=g:20s,sci:20s,diy:20s,3:20s

# Worker pool size. Optional — defaults to 2.
# POLLER_WORKERS=2
